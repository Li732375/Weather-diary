import requests
import json
import matplotlib.pyplot as plt
import os
from matplotlib import font_manager
from datetime import datetime, timedelta
from multiprocessing import Pool, cpu_count
from zoneinfo import ZoneInfo
from matplotlib.ticker import MaxNLocator


Encoding = "utf-8-sig"
API_KEY = "YOUR_API_KEY"  # 從 GitHub Secrets 設定
ElementName_list = ["溫度", "體感溫度", "相對濕度", "3小時降雨機率"]  # 設定目標氣象因子資訊
Date = datetime.now(ZoneInfo("Asia/Taipei"))  # 設定時區為台北
Date_Now = Date.strftime('%Y-%m-%d')
Weekday_Map = ["一", "二", "三", "四", "五", "六", "日"]
Date_Weekday_zh = Weekday_Map[Date.weekday()]
Output_File = "README.md"  # 設定輸出檔案名稱
Save_Floder_Link = "Tables"  # 設定儲存圖表的資料夾路徑
DAY_BG_COLOR_DARK = "#000000"  # 設定圖表背景顏色 DAY_BG_COLOR_DARK
DAY_BG_COLOR_LIGHT = "#ffffff"  # 設定圖表前景顏色
TABLE_ALPHA = 0.1  # 設定圖表背景透明度


os.makedirs(Save_Floder_Link, exist_ok=True)  # 確保 Tables 資料夾存在

# 清空資料夾
for filename in os.listdir(Save_Floder_Link):
    file_path = os.path.join(Save_Floder_Link, filename)
    if os.path.isfile(file_path):
        os.remove(file_path)


# 獲取天氣資料
def get_weather_data():
    element_names = ",".join(ElementName_list)
    URL = f"https://opendata.cwa.gov.tw/api/v1/rest/datastore/F-D0047-065?Authorization={API_KEY}&ElementName={element_names}&format=JSON&sort=time"

    # 取得資料轉換為 JSON 格式
    response = requests.get(URL)
    data = response.json()
    
    # 儲存 JSON 結果
    data_id = data["records"]["Locations"][0]["Dataid"]
    with open(f"3day_weather_forecast_data_{data_id}.json", "w", encoding="utf-8-sig") as f:
        json.dump(data, f, ensure_ascii=False, indent=2)
    
    return data

# Linux/GitHub Actions 專用，設定中文字型
def setup_chinese_font():
    font_path = "/usr/share/fonts/NotoSansCJKtc-Regular.otf"
    prop = font_manager.FontProperties(fname=font_path)
    plt.rcParams['font.family'] = prop.get_name()

# 繪製因子變化數據
def get_trend_values(location_data, Date_Now):
    factory_dict = {}  # 儲存所有因子數據

    # 取得所有氣象因子數據
    for element in location_data["WeatherElement"]:
        element_name_zh = element["ElementName"]  # 取得氣象因子中文名稱
        element_values = []

        if "DataTime" in element["Time"][0]:
            data_times = []

            for time_info in element["Time"]:
                # 取得時間資訊
                dt = datetime.fromisoformat(time_info["DataTime"])
                data_times.append(dt)

                # 取得氣象因子數值
                element_name_en = list(time_info["ElementValue"][0].keys())[0]  # 取得因子英文名稱
                element_value = list(time_info["ElementValue"][0].values())[0]  # 取得因子單筆數值
                element_values.append(int(element_value))

            table_name = f"{Date_Now}_{element_name_en}_{location_data['Geocode']}"
            factory_dict[element_name_zh] = (table_name, 
                                             data_times, 
                                             element_values)
                   
        elif "StartTime" in element["Time"][0] and "EndTime" in element["Time"][0]:
            data_start_times = []
            data_end_times = []

            for time_info in element["Time"]:
                # 取得時間資訊
                start_time = datetime.fromisoformat(time_info["StartTime"])
                end_time = datetime.fromisoformat(time_info["EndTime"])
                data_start_times.append(start_time)
                data_end_times.append(end_time)

                # 取得氣象因子數值
                element_name_en = list(time_info["ElementValue"][0].keys())[0]  # 取得因子英文名稱
                element_value = list(time_info["ElementValue"][0].values())[0]  # 取得因子單筆數值
                element_values.append(int(element_value))

            table_name = f"{Date_Now}_{element_name_en}_{location_data['Geocode']}"
            factory_dict[element_name_zh] = (table_name, 
                                             data_start_times,
                                             data_end_times, 
                                             element_values)
    
    # 繪圖相關設定
    plt.style.use('dark_background')  # 背景樣式
    _, (ax1, ax2) = plt.subplots(  # 建立兩個子圖 (2 排, 1 欄)，並設定高度比例
        nrows=2,
        ncols=1,
        figsize=(9, 6),  # 長寬比
        gridspec_kw={'height_ratios': [10, 1]}
    )

    location_table_paths = []  # 儲存該區所有圖表路徑

    # 繪製多因子折線圖
    plot_lines_chart(
        ax1,
        factory_dict["溫度"][1][:25],  # 因子時間，單日僅需顯示前 25 筆資料
        **{k: factory_dict[k][-1][:25] for k in ["溫度", \
                                                 "體感溫度", \
                                                 "相對濕度"]}  # 指定因子，單日僅需顯示前 25 筆資料
    )
    
    # 繪製甘特圖
    plot_gantt_chart(
        ax2,
        factory_dict["3小時降雨機率"][1][:8],  # 因子起始時間，單日僅需顯示前 25 筆資料
        factory_dict["3小時降雨機率"][2][:8],  # 因子結束時間，單日僅需顯示前 25 筆資料
        factory_dict["3小時降雨機率"][3][:8]  # 因子資料，單日僅需顯示前 25 筆資料
    )

    # 調整圖距
    plt.tight_layout()

    # 輸出圖片
    table_name_en = f"{Date_Now}_ATemp&Temp&ReHum_{location_data['Geocode']}"
    image_path = f"{Save_Floder_Link}/{table_name_en}.png"
    plt.savefig(image_path, dpi=100)
    plt.close()

    location_table_paths.append(image_path)
    
    return location_data["LocationName"], location_table_paths

# 繪製甘特圖
def plot_gantt_chart(ax, start_times, end_times, data_values):
    # 設定跨日背景
    prev_day = start_times[0].day
    start_idx = start_times[0]
    color_toggle = True  # 控制顏色交錯

    for i, dt in enumerate(start_times):
        if dt.day != prev_day or i == len(start_times) - 1:
            end_idx = dt if dt.day != prev_day else end_times[-1]
            color = DAY_BG_COLOR_LIGHT if color_toggle else DAY_BG_COLOR_DARK
            ax.axvspan(start_idx, end_idx, color=color, alpha=TABLE_ALPHA)
            prev_day = dt.day
            start_idx = dt
            color_toggle = not color_toggle

    # 將百分比轉換為 Y 值
    y_values = [v / 100 for v in data_values]

    # 繪製每個區段為橫條
    for i in range(len(start_times)):
        label_color = interpolate_color(y_values[i], (0.55, 0.55, 0.55), (0, 0, 1))  # 漸層顏色插值計算
        
        # 繪出區段橫條
        ax.barh(0.5, 
                width=end_times[i] - start_times[i], 
                left=start_times[i],
                height=1, 
                align='center', 
                color=label_color
                )

        # 顯示百分比數值
        ax.text(start_times[i] + (end_times[i] - start_times[i]) / 2,
                0.4,
                f"{data_values[i]}", 
                ha='center', 
                va='center', 
                color='white', 
                fontsize=22,
                fontweight='bold'
                )
    
    # 顯示網格
    ax.grid(True, linestyle='--', alpha=0.3)

    # 設定 X 軸
    xticks = start_times + [end_times[-1]] if end_times[-1] not in start_times else start_times
    tick_labels = [f"{dt.strftime('%H')}\n{Weekday_Map[dt.weekday()]}" for dt in xticks]
    ax.set_xticks(xticks)
    ax.set_xticklabels(tick_labels, rotation=0, fontsize=20)
    margin = timedelta(hours=1)  # 設定 X 軸邊界距離
    ax.set_xlim(min(start_times) - margin, max(end_times) + margin)

    # 設定 Y 軸（隱藏）
    ax.set_ylim(0, 1)
    ax.yaxis.set_visible(False)
    ax.text(start_times[-1] + (end_times[-1] - start_times[-1]) + margin * 1.3, 
            0.3, 
            "( % )", 
            fontsize=18, 
            color='white', 
            fontweight='bold'
            )

# 顏色插值計算
def interpolate_color(value, start_rgb, end_rgb):
    return tuple(start_rgb[j] + value * (end_rgb[j] - start_rgb[j]) for j in range(3))

# 繪製多因子折線圖
def plot_lines_chart(ax, data_times, **data_values_dict):
    # 設定跨日背景
    prev_day = data_times[0].day
    start_idx = 0
    color_toggle = True  # 控制背景顏色交錯

    for i, dt in enumerate(data_times):
        if dt.day != prev_day or i == len(data_times) - 1:
            end_idx = i if dt.day != prev_day else i + 1
            color = DAY_BG_COLOR_LIGHT if color_toggle else DAY_BG_COLOR_DARK
            ax.axvspan(start_idx, end_idx, color=color, alpha=TABLE_ALPHA)
            prev_day = dt.day
            start_idx = i
            color_toggle = not color_toggle

    # 切分溫度與相對溼度因子
    Temp_and_ATemp_items = [(k, data_values_dict[k]) for k in ["溫度", "體感溫度"]]
    R_Hum_item = [(k, data_values_dict[k]) for k in ["相對濕度"]]

    # 設定兩種溫度折現線條
    for element, value_list in Temp_and_ATemp_items:
        ax.plot(range(len(data_times)), 
                value_list,
                marker="o", 
                linestyle="-", 
                linewidth=2,
                label=element
                )
        
        # 找到最大值與最小值的數字標籤
        max_idx = value_list.index(max(value_list))
        min_idx = value_list.index(min(value_list))

        # 標註最大值
        ax.text(max_idx,
                value_list[max_idx] + 0.15,
                f"{value_list[max_idx]:.0f}",
                ha='center',
                va='bottom',
                fontsize=24,
                color='orange',
                fontweight='bold')

        # 標註最小值
        ax.text(min_idx,
                value_list[min_idx] - 0.5,
                f"{value_list[min_idx]:.0f}",
                ha='center',
                va='top',
                fontsize=24,
                color='cyan',
                fontweight='bold')

    # 新增右 Y 軸
    ax2 = ax.twinx()
    
    # 設定相對溼度因子折現線條
    for element, value_list in R_Hum_item:
        ax2.plot(range(len(data_times)), 
                value_list,
                marker="o", 
                linestyle="-", 
                color="#008585", 
                linewidth=2,
                label=element
                )
        
    # 設定點上標記字型
    for x, y in zip(range(len(data_times)), value_list):
        ax2.text(x, 
                y + 0.15, 
                f"{y:.0f}", 
                ha='center', 
                va='bottom', 
                fontsize=16, 
                color='#9C9C9C',
                fontweight='bold'
                )

    # 顯示網格
    ax.grid(True, linestyle='--', alpha=0.3)
    
    # 設定 X 軸
    xtick_locs = set(range(0, len(data_times), 3))  # 每 3 筆顯示刻度
    xtick_locs.update([0, len(data_times) - 1])  # 確保顯示第一筆和最後一筆
    xtick_locs = sorted(xtick_locs)
    ax.set_xticks(xtick_locs)
    ax.set_xticklabels(["" for i in xtick_locs], fontsize=0)
    ax.set_xlim(-0.8, len(data_times) - 0.2)

    # 設定左 Y 軸
    Temp_and_ATemp_values = [v for _, v in Temp_and_ATemp_items]
    max_value = max(max(v) for v in Temp_and_ATemp_values)
    min_value = min(min(v) for v in Temp_and_ATemp_values)
    padding = max(1, int((max_value - min_value) * 0.2))
    ax.tick_params(axis='y', labelsize=18)
    ax.set_ylim(min_value - padding * 1.6, max_value + padding * 1.9)
    ax.yaxis.set_major_locator(MaxNLocator(integer=True))
    ax.text(-2.4, 
            max_value + padding * 2.2, 
            "( °C )", 
            fontsize=18, 
            color='white', 
            fontweight='bold'
            )
    
    # 設定右 Y 軸
    R_Hum_values = [v for _, v in R_Hum_item]
    max_value = max(max(v) for v in R_Hum_values)
    min_value = min(min(v) for v in R_Hum_values)
    padding = max(1, int((max_value - min_value) * 0.2))
    ax2.tick_params(axis='y', labelsize=20)
    yticks = ax2.get_yticks()
    ax2.set_yticks(yticks)  # 先設定 ticks
    ax2.set_yticklabels(["" for _ in yticks], fontsize=0)  # 才能設定 label
    ax2.set_ylim(min_value - padding * 1.6, max_value + padding * 1.9)
    ax2.yaxis.set_major_locator(MaxNLocator(integer=True))
    ax2.text(len(data_times) - 0, 
             max_value + padding * 2.2, 
             "( % )", 
             fontsize=18, 
             color='white', 
             fontweight='bold'
             )
    
    # 設定圖例
    lines1, labels1 = ax.get_legend_handles_labels()  # 取得左 Y 軸圖例
    lines2, labels2 = ax2.get_legend_handles_labels()  # 取得右 Y 軸圖例
    ax.legend(lines1 + lines2, labels1 + labels2,  # 合併圖例
              fontsize=20, 
              prop={'weight': 'bold'},
              ncol=3)

if __name__ == "__main__":
    setup_chinese_font()  # Linux/GitHub Actions 專用，設定中文字型

    # 取得氣象資料
    data = get_weather_data()

    # 多進程繪圖
    '''
    # 可以自行調整 processes 數量

    實際建議上限：不超過 CPU 實體或邏輯核心數量。例如：4 核心 8 線程的 CPU：建議上限 ≈ 8。

    若設太多（如 processes=1000），可能導致：
    - 系統過載（CPU 使用率 100%）；
    - 任務切換過於頻繁，反而變慢；
    - 記憶體不足或進程排程失敗。
    '''
    loc_list = data["records"]["Locations"][0]["Location"]
    args_list = [(loc, Date_Now) for loc in loc_list]

    with Pool(processes=cpu_count()) as pool:
        # 圖表繪製
        results = pool.starmap(get_trend_values, args_list)

    # 寫入 Markdown 檔案
    city_name = data["records"]["Locations"][0]["LocationsName"]  # 縣市名稱
    Output_File_content = [
        f"# {Date_Now} ({Date_Weekday_zh}) {city_name} 天氣預報\n",
    ]

    table_title_names = ["溫度 / 相對溼度 / 降雨機率"]  # 圖表標題

    for District_Name, Table_links in results:
        Output_File_content.append(f"## {District_Name}：\n\n")

        for link, title in zip(Table_links, table_title_names):
            Output_File_content.append(f"### {title}\n\n")
            Output_File_content.append(f"![該區今明預報圖]({'./' + link})\n\n")
        
        Output_File_content.append("\n")

    Output_File_content.append("\n\n## 資料來源")
    Output_File_content.append("\n中央氣象署開放資料平臺 API：https://opendata.cwa.gov.tw/dist/opendata-swagger.html#/%E9%A0%90%E5%A0%B1/get_v1_rest_datastore_F_D0047_065\n\n")

    with open(Output_File, "w", encoding=Encoding) as f:
        f.writelines(Output_File_content)

        now_time = datetime.now(ZoneInfo("Asia/Taipei"))
        f.write(f"\n\n {now_time.strftime('%Y-%m-%d %H:%M:%S')} 更")
